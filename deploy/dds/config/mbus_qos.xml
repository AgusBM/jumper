        <!-- High-rate motion-planner debug stream: best-effort, volatile,
             keep-last-1 so a slow subscriber never back-pressures the RT loop. -->

        <!-- PhoneControl::Message (手机 App -> control-agent-cpp): 50Hz 控制指令 / ~1Hz 状态回传。
             Best-effort, volatile, keep-last-1, 跟上 / 下的机器人控制走同样的 QoS 设定。 -->

        <!-- Audio PCM stream: best-effort, volatile, keep-last-8 (~80 ms at
             10 ms periods). Depth > 1 so a burst of periods is not collapsed
             to a single sample (unlike video KEEP_LAST 1). -->
            <!-- RobotControlRaw::ControlRaw (control-pod-svc): 50Hz Xbox-aligned snapshot.
             Best-effort, volatile, keep-last-1 — same pattern as VR control frame. -->
        <qos_profile name="RobotControlRaw_ControlRaw">
            <domain_participant_qos></domain_participant_qos>
            <publisher_qos></publisher_qos>
            <subscriber_qos></subscriber_qos>
            <topic_qos>
                <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
                <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
                <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>1</depth></history>
                <resource_limits>
                    <max_samples>10</max_samples>
                    <max_instances>1</max_instances>
                    <max_samples_per_instance>10</max_samples_per_instance>
                </resource_limits>
                <transport_priority><value>10</value></transport_priority>
            </topic_qos>
            <datawriter_qos>
                <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
            </datawriter_qos>
            <datareader_qos>
                <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
            </datareader_qos>
        </qos_profile>

