<?xml version="1.0" encoding="UTF-8"?>
<!-- Trimmed from mbus/config/mbus_qos.xml to the profiles this FSM uses.
     Copied verbatim, never retyped: QoS that does not match the other side
     makes DDS silently never pair the reader and the writer. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.omg.org/spec/DDS-XML"
    xsi:schemaLocation="http://www.omg.org/spec/DDS-XML http://www.omg.org/spec/DDS-XML/20180501/dds-xml_qos_definitions.xsd">
    <qos_library name="mbus">
        <qos_profile name="common">
            <!-- Domain -->
            <domain_participant_qos>
            </domain_participant_qos>
            <!-- Publisher -->
            <publisher_qos>
                <presentation>
                    <access_scope>INSTANCE_PRESENTATION_QOS</access_scope>
                    <coherent_access>false</coherent_access>
                    <ordered_access>true</ordered_access>
                </presentation>
            </publisher_qos>
            <!-- Subscriber -->
            <subscriber_qos>
                <presentation>
                    <access_scope>INSTANCE_PRESENTATION_QOS</access_scope>
                    <coherent_access>false</coherent_access>
                    <ordered_access>true</ordered_access>
                </presentation>
            </subscriber_qos>
        </qos_profile>



        <qos_profile name="MotorControl_Control">
            <!-- Domain -->
            <domain_participant_qos>
            </domain_participant_qos>
            <!-- Publisher -->
            <publisher_qos>
            </publisher_qos>
            <!-- Subscriber -->
            <subscriber_qos>
            </subscriber_qos>
            <!-- Topic -->
            <topic_qos>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <reliability>
                    <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
                </reliability>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
                <resource_limits>
                    <max_samples>10</max_samples>
                    <max_instances>10</max_instances>
                    <max_samples_per_instance>10</max_samples_per_instance>
                </resource_limits>
                <transport_priority>
                    <value>10</value>
                </transport_priority>
            </topic_qos>
            <!-- DataWriter -->
            <datawriter_qos>
                <reliability>
                    <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
                </reliability>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
                <resource_limits>
                    <max_samples>10</max_samples>
                    <max_instances>10</max_instances>
                    <max_samples_per_instance>10</max_samples_per_instance>
                </resource_limits>
            </datawriter_qos>
            <!-- DataReader -->
            <datareader_qos>
                <reliability>
                    <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
                </reliability>
                <destination_order>
                    <kind>BY_SOURCE_TIMESTAMP_DESTINATIONORDER_QOS</kind>
                </destination_order>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>1</depth>
                </history>
                <resource_limits>
                    <max_samples>10</max_samples>
                    <max_instances>10</max_instances>
                    <max_samples_per_instance>10</max_samples_per_instance>
                </resource_limits>
            </datareader_qos>
        </qos_profile>

